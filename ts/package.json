{
  "name": "nameguard",
  "version": "0.1.0",
  "description": "Fast, zero-dependency checker that blocks reserved, brand, abusive and scam names in slugs, subdomains and usernames.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "slug",
    "subdomain",
    "username",
    "profanity",
    "blocklist",
    "reserved",
    "validation",
    "hinglish"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bench:scale": "tsx bench/scale.ts",
    "sync-data": "node ../scripts/sync-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "author": "Syed Ehsan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyedEhsan06/nameguard.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/SyedEhsan06/nameguard/issues"
  },
  "homepage": "https://github.com/SyedEhsan06/nameguard#readme"
}
